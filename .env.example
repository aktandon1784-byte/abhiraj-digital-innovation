# ====================================================================
# RAZORPAY PAYMENT GATEWAY CREDENTIALS (SERVER-SIDE ONLY)
# ====================================================================
# Obtain credentials from Razorpay Dashboard: Settings -> API Keys
# Test keys begin with 'rzp_test_', live production keys with 'rzp_live_'
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Webhook Secret (Razorpay Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# Public Key ID for Razorpay Checkout script (optional, can mirror RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ====================================================================
# APPLICATION & DOWNLOAD CONFIGURATION
# ====================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Download Access Policy: 'public' | 'subscription_required'
# 'public': Anyone can download once real APK is placed; access is controlled inside the app.
# 'subscription_required': APK download requires verified subscription.
DOWNLOAD_ACCESS_POLICY=public

# Optional: Custom path to signed APK file on server
# ANDROID_APK_PATH=
